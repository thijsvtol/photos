{
  "name": "photos-worker",
  "version": "2.2.7",
  "description": "Cloudflare Worker backend for photo sharing application",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy",
    "test": "vitest run --passWithNoTests",
    "test:coverage:security": "vitest run src/test/securityRoutesCoverage.test.ts --coverage --coverage.include=src/routes/media.ts --coverage.include=src/routes/zip.ts --coverage.thresholds.lines=100 --coverage.thresholds.functions=100 --coverage.thresholds.statements=100 --coverage.thresholds.branches=100",
    "test:integration:staging": "vitest run src/test/stagingIntegration.test.ts",
    "test:integration:staging:full": "vitest run src/test/stagingIntegration.test.ts src/test/stagingRoutesIntegration.test.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "form-data": "^4.0.6",
    "hono": "^4.13.9",
    "jose": "^6.2.3",
    "mailgun.js": "^14.0.1",
    "ulid": "^3.0.2"
  }
}
